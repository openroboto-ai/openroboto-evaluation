  "camera_rig": {
    "profile_id": "realsense_d405_exterior_plus_link8_zed_mini_v3",
    "reference": "The single exterior frontview camera uses an Intel RealSense D405 RGB pinhole proxy at the existing user-specified pose. The wrist camera retains the DROID-informed link8 ZED Mini proxy with AXIS virtual stereo-center and gripper-visibility framing overrides.",
    "configured_exterior_camera_count": 1,
    "configured_wrist_camera_count": 1,
    "exterior_rgb_stream": "left_imager_rgb_with_isp",
    "wrist_rgb_stream": "virtual_stereo_center_rgb",
