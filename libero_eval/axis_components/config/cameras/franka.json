      "frontview": {
        "resolution": [1280, 720],
        "fps": 30,
        "maximum_rgb_fps": 90
      },
      "wrist": {
        "resolution": [1280, 720],
        "fps": 60
      }
    },
    "dataset_resolution": [
      320,
      180
    ],
    "runtime_note": "MuJoCo renders each configured view as one distortion-free pinhole RGB proxy. Frontview uses the D405 product-level 58-degree nominal vertical FOV for its 1280x720 ISP RGB profile while preserving the existing pose; per-device fx/fy/ppx/ppy and distortion are not claimed. The wrist view remains an explicitly virtual stereo-center proxy with a render-validated +8 degree local pitch for increased Panda gripper visibility and a user-specified 52-degree nominal vertical FOV. Runtime rendering remains strictly limited to 16:9, such as 320x180 or 1280x720, and stored Robosuite data remains normalized to 15 Hz.",
    "references": {
      "realsense_d405_product": "https://www.realsenseai.com/products/stereo-depth-camera-d405/",
      "realsense_d400_datasheet": "https://www.realsenseai.com/download/21345/",
      "realsense_projection_and_intrinsics": "https://dev.realsenseai.com/docs/projection-texture-mapping-and-occlusion-with-intel-realsense-depth-cameras/",
      "droid_hardware": "https://droid-dataset.github.io/droid/hardware-setup/assembly.html#mounting-hand-camera-on-robot",
      "droid_capture": "https://github.com/droid-dataset/droid/blob/33ae6a67274f36d2e29525b86f23a56616ef43a7/droid/camera_utils/camera_readers/zed_camera.py",
      "droid_sim_eval_cameras": "https://github.com/arhanjain/sim-evals/blob/3a6b0e8177f696947f49c082728f10ef5133ede1/src/sim_evals/environments/droid_environment.py",
      "droid_sim_asset": "https://huggingface.co/datasets/owhan/DROID-sim-environments/blob/main/franka_robotiq_2f_85_flattened.usd"
    }
  },
  "capture_multiplexing": {
    "schema": "fixed_plus_randomized_camera_pairs_v1",
    "enabled": true,
    "fixed_replicas": 1,
    "randomized_replicas": 4,
    "pairing": "same_replica_index_frontview_and_wrist",
    "dataset_layout": {
      "fixed": "camera_fixed",
      "randomized": "camera_randomized"
    },
    "semantics": "Replay each source state once, render one fixed plus four randomized frontview/wrist pairs, and write one fixed episode plus four randomized episodes with the standard third_person+wrist policy schema.",
    "split_policy": "All five paired episodes share a source_trajectory_group_id and must remain in the same train/validation/test split."
  },
