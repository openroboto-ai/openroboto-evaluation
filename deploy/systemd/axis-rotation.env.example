# Example for the dev instance. Use separate literal paths and credentials for production.
# Copy to ~/.config/openroboto/axis-rotation-dev.env with mode 0600.
VALIDATOR_ROOT=/absolute/path/to/validator
BACKEND_URL=https://backend.example.invalid
BACKEND_PUBLIC_API_KEY=replace-me
BACKEND_ADMIN_API_KEY=replace-me
WORKER_KEY=replace-me
DOWNLOAD_STRATEGIES=hfd-mirror,hub-mirror
AXIS_GPUS=0

AXIS_SELECTOR_ROOT=/absolute/path/to/pinned-axis-task-selector
AXIS_RUNTIME_POOL=/absolute/path/to/frozen-runtime-pool/manifest.json
AXIS_BENCHMARK_DIR=/absolute/path/to/validator/.cache/axis/rotation-dev
AXIS_STATE_FILE=/absolute/path/to/validator/eval_runs_dev/rotation-worker-state.json
AXIS_OUTPUT_ROOT=/absolute/path/to/validator/eval_runs_dev/rotation
MODEL_DOWNLOAD_DIR=/absolute/path/to/validator/hf_models

OPENPI_DIR=/absolute/path/to/pinned-openpi-checkout
AXIS_RUNTIME_DIR=/absolute/path/to/validator/third_party/axis-runtime
EVALUATOR_SOURCE_GIT_COMMIT=replace-with-40-character-validator-commit
NO_PROXY=127.0.0.1,localhost,::1
no_proxy=127.0.0.1,localhost,::1
